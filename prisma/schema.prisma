generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  empresa   String?
  email     String?
  telefono  String?
  creadoEn  DateTime @default(now())
}

model Proyecto {
  id        String   @id @default(cuid())
  nombre    String
  cliente   String?
  estado    String   @default("Pendiente")
  fecha     String?
  creadoEn  DateTime @default(now())
}

model Transaccion {
  id          String   @id @default(cuid())
  descripcion String
  monto       Float
  tipo        String
  categoria   String?
  fecha       String?
  creadoEn    DateTime @default(now())
}